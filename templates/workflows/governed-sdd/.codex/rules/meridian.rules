# Meridian governed-SDD command approval policy.
#
# Codex loads this project-local file only after the project's .codex layer is
# trusted in ~/.codex/config.toml. An untrusted project silently ignores it.
# Check this file's decisions with:
#   codex execpolicy check --rules .codex/rules/meridian.rules -- git status
# Confirm activation separately: in a trusted governed-SDD session, an allowed
# command that previously prompted must run without an approval prompt.
#
# Rules combine with ~/.codex/rules/default.rules; the most restrictive matching
# decision wins. `git -C <path> ...` cannot be matched generally by a prefix
# rule, so use the execution tool's working-directory parameter instead.
#
# Use one command per execution call. On Codex CLI 0.155.1, a trusted-project
# probe found `git status && git diff --check` ran without a prompt and a chain
# containing `git push --force` was refused, but `git status && git rebase main`
# ran without a prompt: an unmatched later segment was not safely evaluated.
# `execpolicy check` evaluates argument vectors, not shell syntax such as `&&`.

# Routine governed-SDD Git operations.
prefix_rule(pattern=["git", ["status", "diff", "log", "show", "rev-parse", "merge-base", "branch", "add"]], decision="allow")
prefix_rule(pattern=["git", "switch"], decision="allow")
prefix_rule(pattern=["git", "commit", "-m"], decision="allow")
prefix_rule(pattern=["git", "merge", "--ff-only"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")

# A reviewer-integrator author override needs a project-specific literal token.
# Add a resolved local rule outside this managed template, for example:
# prefix_rule(pattern=["git", "commit", "--author=Project Reviewer-Integrator <reviewer@project.local>", "-m"], decision="allow")

# Read-only and validation-only Meridian commands. State-changing commands,
# including `upgrade`, `adopt`, `lock`, `finalize-adoption`, `generate-*`, and
# `execution reconcile`, intentionally retain Codex's normal approval flow.
prefix_rule(pattern=["meridian", ["context", "locations", "adr", "budget", "audit"]], decision="allow")
prefix_rule(pattern=["meridian", "execution", ["validate", "ready-check", "handoff-check", "preflight", "evidence", "contract", "investigate"]], decision="allow")

# More restrictive matches override the broad Git rules above.
prefix_rule(pattern=["git", "push", ["--force", "-f", "--force-with-lease", "--delete", "--mirror"]], decision="forbidden")
prefix_rule(pattern=["git", "branch", ["-D", "--delete", "--force", "-f"]], decision="prompt")
