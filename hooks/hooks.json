{
  "description": "Meridian — display the task queue briefing at the start of each prompt in Meridian projects",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/hooks/queue-briefing.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
